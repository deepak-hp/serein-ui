{
  "name": "@serein-ui/native-playground",
  "version": "0.0.0",
  "private": true,
  "description": "Expo app showing @serein-ui/native components in light and dark.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export": "expo export --platform all",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.14",
    "@serein-ui/format": "workspace:*",
    "@serein-ui/native": "workspace:*",
    "expo": "58.0.11",
    "expo-font": "58.0.8",
    "expo-status-bar": "58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "6.0.3"
  }
}
