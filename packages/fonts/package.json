{
  "name": "@serein-ui/fonts",
  "version": "0.1.0",
  "description": "Self-hosted Serein fonts: Anek Latin (variable weight and width) and Chivo Mono. No third-party font CDN.",
  "license": "OFL-1.1",
  "repository": { "type": "git", "url": "git+https://github.com/deepak-hp/serein-ui.git", "directory": "packages/fonts" },
  "homepage": "https://github.com/deepak-hp/serein-ui/tree/main/packages/fonts#readme",
  "bugs": { "url": "https://github.com/deepak-hp/serein-ui/issues" },
  "keywords": ["serein", "design-system", "fonts", "anek-latin", "chivo-mono", "woff2"],
  "publishConfig": { "access": "public" },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "OFL.txt"
  ],
  "exports": {
    ".": "./dist/fonts.css",
    "./fonts.css": "./dist/fonts.css",
    "./files/*": "./dist/files/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs --check"
  },
  "devDependencies": {
    "@fontsource-variable/anek-latin": "5.3.0",
    "@fontsource-variable/chivo-mono": "5.3.0"
  }
}
