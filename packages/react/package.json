{
  "name": "@serein-ui/react",
  "version": "0.1.0",
  "description": "React web component library with typed components, compiled CSS, accessibility guidance, and AI integration materials.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepak-hp/serein-ui.git"
  },
  "homepage": "https://github.com/deepak-hp/serein-ui#readme",
  "bugs": {
    "url": "https://github.com/deepak-hp/serein-ui/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "files": [
    "dist",
    "ai",
    "docs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    },
    "./fonts.css": {
      "types": "./dist/fonts.d.ts",
      "default": "./dist/fonts.css"
    },
    "./ai/contract.json": "./ai/contract.json",
    "./ai/llms-full.txt": "./ai/llms-full.txt"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.lib.json && node scripts/build-ai.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:consumer": "node scripts/consumer-check.mjs",
    "release:prepare": "node scripts/prepare-beta-release.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test:package": "node --test scripts/check-package.test.mjs",
    "check:ssr": "node scripts/check-ssr.mjs",
    "check:production": "pnpm run check && pnpm run check:package && pnpm run ai:check && pnpm run check:ssr && pnpm run check:consumer",
    "check": "pnpm run test && pnpm run build && pnpm run typecheck",
    "storybook": "pnpm run build && storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build:storybook": "pnpm run build && storybook build --disable-telemetry",
    "test:stories": "pnpm run build && node scripts/test-stories.mjs",
    "ai:check": "node scripts/check-ai.mjs",
    "test:ai-freshness": "node --test scripts/ai-freshness.test.mjs",
    "ai:check-mcp": "node scripts/check-mcp.mjs",
    "test:browser-install": "node scripts/install-browser.mjs",
    "check:docs": "node scripts/check-storybook-docs.mjs",
    "check:storybook-ui": "node scripts/check-storybook-dist.mjs && node scripts/check-storybook-ui.mjs",
    "check:layout": "node scripts/check-library-layout.mjs",
    "check:search-layout": "node scripts/check-search-layout.mjs",
    "check:menu-select": "node scripts/check-menu-select.mjs",
    "check:date-layout": "node scripts/check-date-layout.mjs",
    "create:app": "node scripts/create-app.mjs",
    "test:starter": "node --test scripts/create-app.test.mjs",
    "check:starter": "node scripts/check-starter.mjs",
    "check:release": "node scripts/release-check.mjs"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@daypicker/react": "10.0.1",
    "@stylexjs/stylex": "0.19.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@serein-ui/fonts": "workspace:*",
    "@serein-ui/format": "workspace:*",
    "@serein-ui/icons": "workspace:*",
    "@serein-ui/tokens": "workspace:*",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-mcp": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@stylexjs/babel-plugin": "0.19.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "playwright": "1.63.0",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
