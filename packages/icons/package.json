{
  "name": "@serein-ui/icons",
  "version": "0.1.0",
  "description": "Serein icon set: 20px grid, 1.5px stroke, square caps.",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/deepak-hp/serein-ui.git", "directory": "packages/icons" },
  "homepage": "https://github.com/deepak-hp/serein-ui/tree/main/packages/icons#readme",
  "bugs": { "url": "https://github.com/deepak-hp/serein-ui/issues" },
  "keywords": ["serein", "design-system", "icons", "svg", "react"],
  "publishConfig": { "access": "public" },
  "sideEffects": false,
  "files": ["dist"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./react": { "types": "./dist/react.d.ts", "default": "./dist/react.js" },
    "./svg/*": "./dist/svg/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run"
  },
  "peerDependencies": { "react": "^18.2.0 || ^19.0.0" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "devDependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vitest": "5.0.3"
  }
}
