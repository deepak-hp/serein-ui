{
  "name": "serein-ui-monorepo",
  "private": true,
  "description": "Serein: a precise, calm, accessible design system for web, mobile and desktop.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test && pnpm specs",
    "typecheck": "turbo run typecheck",
    "specs": "node scripts/check-specs.mjs",
    "storybook": "pnpm --filter @serein-ui/react storybook",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "turbo": "2.11.7",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
