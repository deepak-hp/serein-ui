    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The clear next action, using the warm flame fill and dark text.",
      "html": "<button class=\"ds-btn-primary\">Send test email <svg aria-hidden=\"true\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:11px 20px;border:1px solid var(--dp-orange-border);border-radius:var(--dp-radius-control);background:var(--dp-orange);color:var(--dp-on-orange);box-shadow:var(--dp-shadow-action);font-family:var(--dp-font);font-size:14px;font-weight:600;line-height:1.4;cursor:pointer;transition:background-color var(--dp-duration-fast) var(--dp-ease-out),box-shadow var(--dp-duration-fast) var(--dp-ease-out),transform var(--dp-duration-fast) var(--dp-ease-out)}.ds-btn-primary:hover{background:var(--dp-orange-hover);box-shadow:var(--dp-shadow-action-hover)}.ds-btn-primary:focus-visible{outline:2px solid var(--dp-focus);outline-offset:3px}.ds-btn-primary:active{background:var(--dp-orange-active);transform:translateY(1px)}"
