      "html": "<span class=\"ds-badge ds-badge-neutral\">Draft</span> <span class=\"ds-badge ds-badge-success\">Ready</span> <span class=\"ds-badge ds-badge-error\">Failed</span> <span class=\"ds-badge ds-badge-warning\">Review</span>",
