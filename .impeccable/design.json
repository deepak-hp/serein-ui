      "refersTo": "dialog",
      "description": "The deepest opaque layer for focused decisions.",
      "html": "<section class=\"ds-dialog\" role=\"dialog\" aria-labelledby=\"ds-dialog-title\"><h2 id=\"ds-dialog-title\">Ready for a quieter inbox?</h2><p>These settings are a local preview. Nothing will be sent or stored.</p><button>Done</button></section>",
      "css": ".ds-dialog{width:min(480px,calc(100vw - 32px));padding:28px;border:1px solid var(--dp-divider);border-radius:var(--dp-radius-dialog);background:var(--dp-raised);color:var(--dp-text);box-shadow:var(--dp-shadow-dialog);font-family:var(--dp-font)}.ds-dialog h2{margin:0 0 10px;font-size:24px;font-weight:650;line-height:1.3;letter-spacing:-.03em}.ds-dialog p{margin:0 0 24px;color:var(--dp-muted);font-size:14px;line-height:1.7}.ds-dialog button{min-height:48px;padding:11px 20px;border:1px solid var(--dp-orange-border);border-radius:var(--dp-radius-control);background:var(--dp-orange);color:var(--dp-on-orange);font:600 14px/1.4 var(--dp-font)}.ds-dialog button:hover{background:var(--dp-orange-hover)}.ds-dialog button:focus-visible{outline:2px solid var(--dp-focus);outline-offset:3px}.ds-dialog button:active{background:var(--dp-orange-active)}"
    }
  ],
  "narrative": {
    "northStar": "Clear Evening Rain",
    "overview": "Serein takes its character from fine rain in a clear evening sky: calm, precise, and perceptible through small changes in light. White and near-black canvases leave room for content, while one warm orange accent makes the next action unmistakable. The metaphor stays in the material and motion language rather than becoming literal imagery.\n\nThe system is restrained and practical. Opaque surfaces layer through closely related neutral fills, controls remain crisp, and movement settles quickly into a stable state. Its astrology-informed foundation remains symbolic through the warm orange action color and dark-text treatment; it does not introduce charts, stars, planets, or other celestial decoration. Existing `--dp-*` custom properties remain the runtime compatibility contract.",
    "keyCharacteristics": [
      "Clear white and deep evening canvases with opaque layered surfaces.",
      "Warm orange actions with dark text and restrained green reserved for real success.",
      "Soft geometry that becomes progressively rounder from controls to dialogs.",
      "Plus Jakarta Sans throughout, with compact labels and measured negative tracking in headings.",
      "Short, settling state changes that retain full meaning without motion."
    ],
    "rules": [
      {
        "name": "The One Warm Signal Rule",
        "body": "Orange identifies the next action or current interactive state; do not spread it across large decorative areas.",
        "section": "colors"
      },
      {
        "name": "The Meaning Before Color Rule",
        "body": "Labels and status copy carry meaning. Green, orange, rose, and amber reinforce that meaning and never replace it.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Use Plus Jakarta Sans for every interface role; build hierarchy through scale, weight, and spacing.",
        "section": "typography"
      },
      {
        "name": "The Measured Tracking Rule",
        "body": "Negative tracking belongs to large headings and wordmarks and never goes below `-0.04em`.",
        "section": "typography"
      },
      {
        "name": "The Opaque Content Rule",
        "body": "Forms, cards, fields, popups, and dialogs stay opaque. Optional translucency belongs to one navigation plane and must have an explicit solid fallback.",
        "section": "layout"
      },
      {
        "name": "The Neutral Depth Rule",
        "body": "Keep cards and grouped surfaces flat at rest; reserve neutral shadow for transient elevation and never add colored ambient glow.",
        "section": "elevation"
      },
      {
        "name": "The Progressive Radius Rule",
        "body": "Keep small controls crisp and reserve the largest curvature for panels and dialogs.",
        "section": "shapes"
      }
    ],
    "dos": [
      "Do keep orange concentrated on primary actions, active navigation details, and current state.",
      "Do pair every semantic color with explicit words or accessible state information.",
      "Do preserve 48px controls, clear focus outlines, opaque content surfaces, and solid navigation fallbacks.",
      "Do use the existing `--dp-*` custom properties when extending the shipped library so consumers retain compatibility.",
      "Do let motion settle quickly and make the same state legible when animation is removed."
    ],
    "donts": [
      "Don't turn the Serein name into rain illustrations, droplets, animated weather, galaxy imagery, stars, or planetary decoration.",
      "Don't add colored ambient glows, decorative gradients, or broad green accent areas.",
      "Don't place translucent material on forms, cards, fields, popups, or dialogs.",
      "Don't infer accessibility certification from automated checks; WCAG 2.2 AA remains the target pending manual review.",
      "Don't describe `@serein-ui/react` as published on npm or its package scope as verified; npm publication is deferred, and the canonical repository is `deepak-hp/serein-ui`."
    ]
  }
}
