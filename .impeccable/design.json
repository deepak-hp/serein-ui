      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;color:var(--dp-text);font-family:var(--dp-font);font-size:14px;font-weight:600}.ds-field input{width:100%;min-height:48px;padding:11px 14px;border:1px solid var(--dp-border);border-radius:var(--dp-radius-control);background:var(--dp-field);color:var(--dp-text);font:400 16px/1.5 var(--dp-font)}.ds-field input:hover{border-color:var(--dp-muted)}.ds-field input:focus-visible{outline:2px solid var(--dp-focus);outline-offset:3px}.ds-field small{color:var(--dp-muted);font-size:13px;font-weight:400;line-height:1.6}"
