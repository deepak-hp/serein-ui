      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9529,
          0.9529,
          0.9451
        ],
        "hex": "#f3f3f1"
      },
      "$description": "Page and screen background. Grounds every text token."
    },
    "surface-raised": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      },
      "$description": "Panels, inputs, keys, the selected segment."
    },
    "surface-sunken": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9137,
          0.9137,
